# VITE_KORA_SECRET_KEY=sk_live_xxxxxxxxxxxx

# ─── Paystack (optional — legacy) ───────────────────────────────────────────
VITE_PAYSTACK_PUBLIC_KEY=

# ─── SEO / launch verification ─────────────────────────────────────────────
# Paste the Google Search Console HTML tag value here after adding the domain.
# Example: <meta name="google-site-verification" content="abc123" /> -> abc123
VITE_GOOGLE_SITE_VERIFICATION=

# ─── WebSocket broadcast service (persistent, no Twilio or SMS gateway) ─────
# Public browser/client endpoint for the long-lived notification socket.
VITE_WS_URL=ws://localhost:3001/ws/notifications
# Long-lived Node service used by the admin backend to fan out broadcasts.
NOTIFICATION_WS_URL=http://localhost:3001
# Shared secret used by the admin backend when it posts to /api/notify.
JOBBRIDGE_WS_ADMIN_KEY=jobbridge-local-dev
# Optional auth token verifying socket clients in production environments.
JOBBRIDGE_WS_SHARED_SECRET=
