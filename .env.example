# ─── AI features (optional — configure server-side only) ─
# NOTE: OpenAI API keys should NEVER be exposed to the client.
# Set DEEPSEEK_API_KEY as a Supabase secret and/or a server-only Vercel variable.
# Set OPENAI_API_KEY server-side only if AI embeddings are enabled.
# Never add VITE_DEEPSEEK_API_KEY or VITE_OPENAI_API_KEY.
# Example: supabase secrets set OPENAI_API_KEY=sk_live_xxxxx

# ─── KoraPay (required for online payments) ────────────────────────────────
# Get your keys at https://dashboard.korapay.com/settings/api-keys
VITE_KORA_PUBLIC_KEY=pk_live_uLyub1JmKvjsQuE8HXYuH7XgeqMYZShgGUWJFpPM
# Only needed for server-side webhook verification (set as Supabase secret)
# KORA_SECRET_KEY=sk_live_xxxxxxxxxxxx

# ─── Paystack (optional — legacy) ───────────────────────────────────────────
VITE_PAYSTACK_PUBLIC_KEY=

# ─── SEO / launch verification ─────────────────────────────────────────────
# Paste the Google Search Console HTML tag value here after adding the domain.
# Example: <meta name="google-site-verification" content="abc123" /> -> abc123
VITE_GOOGLE_SITE_VERIFICATION=

# ─── WebSocket broadcast service (persistent, no Twilio or SMS gateway) ─────
# Public browser/client endpoint for the long-lived notification socket.
VITE_WS_URL=ws://localhost:3001/ws/notifications
VITE_WS_URL=wss://ws.jobbridge.com.ng/ws/notifications
# Long-lived Node service used by the admin backend to fan out broadcasts.
NOTIFICATION_WS_URL=http://localhost:3001
NOTIFICATION_WS_URL=https://ws.jobbridge.com.ng
# Shared secret used by the admin backend when it posts to /api/notify.
JOBBRIDGE_WS_ADMIN_KEY=jobbridge-local-dev
JOBBRIDGE_WS_ADMIN_KEY=replace-with-a-long-random-admin-key
# Optional auth token verifying socket clients in production environments.
JOBBRIDGE_WS_SHARED_SECRET=
JOBBRIDGE_WS_SHARED_SECRET=replace-with-a-long-random-client-token
